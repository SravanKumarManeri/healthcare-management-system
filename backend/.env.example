# Healthcare Management System - Backend Environment Configuration

# Django Core Settings
DJANGO_SECRET_KEY=django-insecure-hms-secret-key-change-in-production-demo-key-2026
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Kolkata

# Primary Database Configuration (MySQL 8.x)
# Note: For development/testing environments without a running MySQL instance,
# set DB_ENGINE=sqlite to activate the built-in SQLite fallback.
DB_ENGINE=mysql
DB_NAME=healthcare_management_db
DB_USER=hms_app_user
DB_PASSWORD=change-this-local-password
DB_HOST=127.0.0.1
DB_PORT=3306

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Security & JWT Configuration
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=7
